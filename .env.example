NODE_ENV=development
GLOSSA_BIND_HOST=127.0.0.1
PORT=39100
DATABASE_URL=postgres://glossa:glossa@localhost:55432/glossa
GLOSSA_DATABASE_SSL_MODE=verify-full
# GLOSSA_DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----..."
GLOSSA_PUBLIC_ORIGIN=http://localhost:39100
GLOSSA_AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
GLOSSA_AUTH0_AUDIENCE=https://mcp.glossa.sh/
GLOSSA_AUTH0_CLI_CLIENT_ID=PUBLIC_NATIVE_CLIENT_ID
# Provider-wide subjects for regular users. Use an exact subject for a
# dedicated reviewer rather than broadening this list to auth0|.
GLOSSA_AUTH0_ALLOWED_SUBJECT_PREFIXES=google-oauth2|
# GLOSSA_AUTH0_ALLOWED_SUBJECTS=auth0|REVIEWER_USER_ID
GLOSSA_MCP_REQUIRED_SCOPE=glossa:access
GLOSSA_DEVICE_ENROLL_SCOPE=glossa:device
GLOSSA_RATE_LIMIT_WINDOW_MS=60000
GLOSSA_ENROLL_RATE_LIMIT=10
GLOSSA_DEVICE_AUTH_RATE_LIMIT=120
GLOSSA_WORKER_POLL_MS=15000
GLOSSA_RELAY_REQUEST_TIMEOUT_MS=20000
# Optional metadata-only request timing logs: operation, status, and duration.
GLOSSA_TIMING_LOGS=0
# Set only while OpenAI domain verification requires the generated token.
# GLOSSA_OPENAI_APPS_CHALLENGE=PASTE_EXACT_PORTAL_TOKEN_HERE
# Optional control panel at /panel for pairing-code redemption and device
# recovery. Requires an Auth0 Regular Web Application; the panel is enabled
# only when all three values are set. The session secret must be at least 32
# characters and stays in the relay environment, never in the database.
# GLOSSA_PANEL_CLIENT_ID=WEB_APPLICATION_CLIENT_ID
# GLOSSA_PANEL_CLIENT_SECRET=WEB_APPLICATION_CLIENT_SECRET
# GLOSSA_PANEL_SESSION_SECRET=LONG_RANDOM_VALUE
