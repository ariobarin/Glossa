{
  "name": "@ariobarin/glossa",
  "version": "0.2.3",
  "private": false,
  "description": "Connect an explicitly exposed local coding workspace to the Glossa MCP relay.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "glossa": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist/main.js",
    "dist/app.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build-package.mjs",
    "hud:demo": "node --import tsx scripts/hud-demo.ts",
    "test": "node --import ./scripts/test-interactive-env.mjs --import tsx --test src/*.test.ts src/worker/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "ink": "5.2.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@glossa/protocol": "*",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/semver": "7.7.1",
    "esbuild": "0.28.1",
    "semver": "7.7.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariobarin/glossa.git"
  },
  "homepage": "https://glossa.sh",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
