{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "glossa": {
      "type": "streamable-http",
      "url": "https://mcp.glossa.sh/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["glossa:access"]
          }
        }
      }
    }
  }
}
